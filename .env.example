# --- Accounts + sync (all optional; the sign-in button is hidden and
# /api/sync returns 401 Unauthorized until every one of these is set) ---
AUTH_SECRET=              # openssl rand -base64 32
EMAIL_SERVER=             # smtp://user%40gmail.com:APP_PASSWORD@smtp.gmail.com:587, Gmail App Password, 2FA required
EMAIL_FROM=               # e.g. "Marketing Academy <you@gmail.com>"
GOOGLE_CLIENT_ID=         # kept wired but not the promoted sign-in path (see README)
GOOGLE_CLIENT_SECRET=
DATABASE_URL=file:./data/marketing-academy.db
TURSO_AUTH_TOKEN=
ADMIN_EMAILS=
SUPERADMIN_EMAILS=        # env-only, never DB-persisted, grants /admin/users (see README)
CRON_SECRET=               # enables 3 /api/cron/* engagement-email routes, set SAME value here AND as a GitHub Actions repo secret (see README)
